body{
font-family:Arial;
margin:0;
background:#f4f4f4;
}

.header{
background:#232f3e;
color:white;
padding:15px;
display:flex;
justify-content:space-between;
}

.nav a{
color:white;
margin:10px;
text-decoration:none;
}

.home-container{
text-align:center;
padding:80px;
}

.btn{
background:#ff9900;
color:white;
padding:10px 20px;
border:none;
text-decoration:none;
border-radius:5px;
}

.product-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
padding:30px;
}

.product-card{
background:white;
padding:20px;
text-align:center;
border-radius:8px;
box-shadow:0 0 10px rgba(0,0,0,0.1);
}

.table-container{
width:80%;
margin:auto;
padding:40px;
}

table{
width:100%;
border-collapse:collapse;
}

th,td{
border:1px solid #ddd;
padding:10px;
text-align:center;
}

.footer{
background:#232f3e;
color:white;
text-align:center;
padding:10px;
margin-top:40px;
}